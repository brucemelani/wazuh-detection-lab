<!-- Custom rules. IDs 100000-120000 are reserved for local use in Wazuh -->
<group name="local,sshd,authentication_failures,">

  <!-- 100100: SSH brute force with a low threshold (5 failures in 60s from the same IP).
       Builds on base rule 5760 (sshd: authentication failed). -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>SSH brute force: 5 or more failed logins in 60s from the same source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>
